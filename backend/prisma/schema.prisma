// This is a Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CodeType {
  SINGLE_USE
  MONTHLY_CARD
}

// 测试题目
model Question {
  id        Int     @id @default(autoincrement())
  title     String  @db.Text
  dimension Int
  order     Int
  createdAt DateTime @default(now())

  @@index([dimension])
}

// 兑换码
model ExchangeCode {
  id                    Int                   @id @default(autoincrement())
  code                  String                @unique @db.VarChar(8)
  codeType              CodeType              @default(SINGLE_USE)
  used                  Boolean               @default(false)
  usedAt                DateTime?
  expiresAt             DateTime?
  useLimit              Int?
  usedCount             Int                   @default(0)
  remark                String?
  groupId               Int?
  group                 TestGroup?            @relation(fields: [groupId], references: [id])
  createdAt             DateTime              @default(now())
  testResults           TestResult[]
  imageAnalysisResults  ImageAnalysisResult[]
  idPhotoResults        IdPhotoResult[]
  idPhotoLayoutResults  IdPhotoLayoutResult[]

  @@index([used])
  @@index([code])
  @@index([codeType])
  @@index([expiresAt])
  @@index([groupId])
}

// 测试分组
model TestGroup {
  id              Int           @id @default(autoincrement())
  name            String        @unique
  description     String?
  allowedTestTypes Json?         @db.Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  exchangeCodes   ExchangeCode[]

  @@index([name])
}

// 测试结果（通用）
model TestResult {
  id             Int          @id @default(autoincrement())
  testType       String
  rawAnswers     Json?
  resultData     Json
  createdAt      DateTime     @default(now())
  exchangeCodeId Int?
  exchangeCode   ExchangeCode? @relation(fields: [exchangeCodeId], references: [id])

  @@index([testType])
  @@index([createdAt])
  @@index([exchangeCodeId])
}

// 管理员账户
model Admin {
  id            Int     @id @default(autoincrement())
  username      String  @unique
  passwordHash  String
  createdAt     DateTime @default(now())
}

// 测试项目配置
model TestConfig {
  id          Int      @id @default(autoincrement())
  typeKey     String   @unique
  name        String
  page        String?
  enabled     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([typeKey])
  @@index([enabled])
  @@index([order])
}

// 图片分析结果
model ImageAnalysisResult {
  id              Int          @id @default(autoincrement())
  analysisType    String       // 分析类型 1-12
  originalPhoto   String       // 原始照片路径
  resultImage     String       // 生成结果图片路径
  expiresAt       DateTime     // 过期时间（3天）
  createdAt       DateTime     @default(now())
  exchangeCodeId  Int?
  exchangeCode    ExchangeCode? @relation(fields: [exchangeCodeId], references: [id])

  @@index([analysisType])
  @@index([expiresAt])
  @@index([exchangeCodeId])
}

// 证件照生成结果
model IdPhotoResult {
  id              Int          @id @default(autoincrement())
  gender          String       // 性别: male/female
  styleType       String       // 风格类型: 1/2/3
  originalPhoto   String       // 原始照片路径
  resultImage     String       // 生成结果图片路径
  expiresAt       DateTime     // 过期时间（3天）
  createdAt       DateTime     @default(now())
  exchangeCodeId  Int?
  exchangeCode    ExchangeCode? @relation(fields: [exchangeCodeId], references: [id])

  @@index([gender])
  @@index([styleType])
  @@index([expiresAt])
  @@index([exchangeCodeId])
}

// 网站访问统计（按天聚合）
model VisitStat {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  page        String
  visits      Int      @default(0)
  uniqueIps   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date, page])
  @@index([date])
  @@index([page])
}

// 访问日志（用于实时统计，定期清理）
model VisitLog {
  id        Int      @id @default(autoincrement())
  page      String
  ip        String?
  userAgent String?
  referer   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([page])
}

// 证件照排版结果
model IdPhotoLayoutResult {
  id              Int          @id @default(autoincrement())
  paperSize       String       // 相纸尺寸: 5inch/6inch/7inch/8inch/10inch/12inch/A4
  photoSize       String       // 照片尺寸: 1inch/2inch/small2inch/big2inch/small1inch/big1inch/visa/usVisa/passport/idcard
  layoutCount     Int          // 排版数量
  originalPhoto   String       // 原始照片路径
  resultImage     String       // 排版结果图片路径
  expiresAt       DateTime     // 过期时间（7天）
  createdAt       DateTime     @default(now())
  exchangeCodeId  Int?
  exchangeCode    ExchangeCode? @relation(fields: [exchangeCodeId], references: [id])

  @@index([paperSize])
  @@index([photoSize])
  @@index([expiresAt])
  @@index([exchangeCodeId])
}
